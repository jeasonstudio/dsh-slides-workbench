{
  "name": "dsh-slides-workbench",
  "version": "0.1.0",
  "description": "DeepSeek Harness 演示文稿工作台：把 open-slide 的做 deck 能力搬进侧栏，AI 写页面，实时预览、演示与导出。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "slides",
    "presentation",
    "open-slide"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeasonstudio/dsh-slides-workbench.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "files": [
    "src",
    "dist",
    "client",
    "template",
    "skills",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/assets"
  ]
}
